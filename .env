# Example environment configuration for MediAssist AI

# API key for the Groq language model.  If left empty the backend
# returns deterministic fallback responses instead of calling the LLM.
GROQ_API_KEY="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" 
# Name of the LLM model to use.  See Groq's documentation for valid
# identifiers.  Defaults to `llama3-8b-8192` if not set.
GROQ_MODEL=llama-3.3-70b-versatile

# Directory for temporarily storing uploaded files.  The directory will
# be created automatically if it does not exist.
TEMP_UPLOAD_DIR=temp_uploads

# Allowed file extensions for uploads.  Comma separated list.
ALLOWED_EXTENSIONS=png,jpg,jpeg,pdf

BACKEND_URL=http://localhost:8000






#GROQ_MODEL=llama-3.1-8b-instant
#BACKEND_URL=http://127.0.0.1:8000
